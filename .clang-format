# ImagoEngine code style
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4          # public:/private: line up with the class keyword
NamespaceIndentation: All

# Line length
ColumnLimit: 100

# Pointers and references attach to the type: T& value, T* ptr
PointerAlignment: Left
ReferenceAlignment: Left

# Braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterNamespace: true            # namespace Imago::ECS
                                  # {
  AfterFunction: true             # void foo()
                                  # {
  AfterClass: false               # check: true if class braces are on their own line
  AfterStruct: false              # check: same as AfterClass
  AfterEnum: false
  AfterControlStatement: Never    # if (x) {
  BeforeElse: false               # } else {
  BeforeCatch: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

# Short forms
AllowShortFunctionsOnASingleLine: Inline   # one-line getters inside a class are fine
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never

# Includes and comments
SortIncludes: Never               # don't reorder includes (some order is load-bearing)
FixNamespaceComments: false       # don't add "// namespace X" after closing braces
ReflowComments: false             # don't rewrap Doxygen comments